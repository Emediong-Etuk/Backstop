# Copy to .env (which git ignores). Never commit real keys, including chipnet ones.

# --- Keeper (optional) ---
# The keeper needs no private key and no funds. Set this to receive keeper rewards;
# leave it empty and the keeper works for free.
KEEPER_REWARD_ADDRESS=

# --- DEMO keys (chipnet only) ---
# Create real values with: npm run demo:keys -- --write
# Demo oracle: signs DEMO prices for the demo price contract. Mainnet uses General Protocols' oracle.
DEMO_ORACLE_WIF=
# Funder: pays for the demo deployment and DEMO price updates.
DEMO_FUNDER_WIF=
# Demo borrower: receives the demo loan keys and runs the scripted setup and withdraw.
DEMO_BORROWER_WIF=
